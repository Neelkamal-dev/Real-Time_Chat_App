# Port the server will run on
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas or local connection)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chat_db?retryWrites=true&w=majority

# JWT Token Secret Key
JWT_SECRET=your_jwt_super_secret_key_here

# Cloudinary Credentials for image sharing uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# URL of the client application (for CORS configuration)
CLIENT_URL=http://localhost:5173

# Google Gemini API key configuration (for Smart Reply, Rewrites, Summaries, RAG embeddings, and Voice Note Transcription)
GEMINI_API_KEY=your_gemini_api_key_here
